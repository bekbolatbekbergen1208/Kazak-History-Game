# Supabase Dashboard → Project Settings → API / Connect.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Browser key: publishable key (or legacy anon key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# SERVER ONLY. Never prefix this with NEXT_PUBLIC_, commit it, or paste it into chat.
# Use a secret key (or legacy service_role key), NOT the browser key.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Public HTTPS URL used in QR codes. Local LAN testing: http://YOUR_LAN_IP:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
